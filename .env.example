# ============================================================
# 环境变量
# 复制为 .env 并填写实际值
# ============================================================

# 数据库密码
DB_PASSWORD=your_db_password_here

# LLM API 密钥（星火格式：APIKey:APISecret）
LLM_API_KEY=your_api_key:your_api_secret

# 星火 APPID（用于 Embedding 等接口）
SPARK_APP_ID=your_app_id_here

# JWT 密钥（生产环境务必使用随机字符串）
JWT_SECRET=your_jwt_secret_here_change_in_production
